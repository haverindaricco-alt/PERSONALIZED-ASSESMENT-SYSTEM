# Salin file ini menjadi .env lalu isi nilainya.

# --- Supabase (Dashboard > Project Settings > API) ---
# URL project, contoh: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Kunci anon (public) project
VITE_SUPABASE_ANON_KEY=

# --- Agnes AI (OPSIONAL — hanya dev langsung tanpa proxy) ---
# Produksi TIDAK memakai variabel ini: panggilan AI lewat /api/agnes-proxy
# (Cloudflare Pages Function) dengan kunci AGNES_API_KEY yang disimpan
# di environment Cloudflare Pages, bukan di file .env.
VITE_AGNES_API_KEY=
VITE_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_AGNES_MODEL=agnes-2.5-flash
